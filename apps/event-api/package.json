{
  "name": "@event-desk/event-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@event-desk/source src/main.ts",
    "start": "node dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:reset": "tsx --conditions=@event-desk/source src/scripts/reset.ts",
    "feedback:simulate": "tsx --conditions=@event-desk/source src/scripts/feedback-simulate.ts"
  },
  "dependencies": {
    "@event-desk/contracts": "workspace:*",
    "@event-desk/tcp-rpc": "workspace:*",
    "bullmq": "6.3.11",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "mysql2": "3.24.5",
    "pino": "10.4.0",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  }
}
