# Copy to .env for local runs: cp .env.example .env
# Values are local-only defaults for the Docker Compose services (docker-compose.yml).

# Event API (binds to loopback only)
HOST=127.0.0.1
PORT=4000
MYSQL_URL=mysql://event_desk:event_desk_local@127.0.0.1:3306/event_desk
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
EVENT_VIEW_CACHE_TTL_MS=30000
# Per-query MySQL deadline (500-60000 ms); also bounds row-lock waits and waiting for a pooled connection
MYSQL_QUERY_TIMEOUT_MS=5000
LOG_LEVEL=info

# Docker Compose overrides (optional): MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD, MYSQL_PORT, REDIS_PORT.
# MySQL creates its users and the event_desk_test database only on an EMPTY volume. After changing
# MYSQL_PASSWORD, recreate the volume: docker compose down -v && pnpm infra:up (this deletes local data).

# AI Gateway (binds to loopback; the event API calls it over TCP from Plan 3B)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4100
# Shared by the event API and the Gateway, at least 32 bytes. Local-only default; for anything
# beyond this machine generate one: openssl rand -hex 32
GATEWAY_SERVICE_SECRET=local-dev-gateway-secret-change-me-0123456789
# Only the Gateway reads the OpenAI settings. Without a key it answers PROVIDER_NOT_CONFIGURED.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=50000
MAX_OUTPUT_TOKENS=4000
# Deadline ceiling per call, and the in-memory daily provider-call backstop
GATEWAY_MAX_CALL_MS=60000
GATEWAY_DAILY_CALL_LIMIT=40
